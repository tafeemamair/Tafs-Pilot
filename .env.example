# ==============================================================================
# Taf's Pilot - Environment Configuration
# ==============================================================================
# AWS Configuration (standard credential provider chain will be used by default:
# AWS CLI profile, IAM Identity Center / SSO, or environment credentials)

# The AWS region where Amazon Bedrock foundation models are enabled
AWS_REGION=us-east-1

# Amazon Bedrock Model ID to invoke for the autonomous producer agent
# (e.g., anthropic.claude-3-5-sonnet-20241022-v2:0, amazon.nova-pro-v1:0, etc.)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: AWS CLI profile name (if using named profiles instead of default)
# AWS_PROFILE=default

# Optional: Temporary / environment session credentials (only if not using AWS CLI / SSO)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
